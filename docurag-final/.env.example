APP_NAME=DocuRAG
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
IMAGE_DATA_DIR=./data/images
INDEX_DATA_DIR=./data/index
DATABASE_URL=sqlite:///./data/index/docurag.db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TEXT_COLLECTION=docurag_text
QDRANT_IMAGE_COLLECTION=docurag_images
TEXT_EMBEDDING_MODEL=nemotron-3-embed-1b
IMAGE_EMBEDDING_MODEL=nvidia/nv-clip-v1
RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
MODEL_CACHE_DIR=./models
DEVICE=cpu
OCR_ENGINE=paddleocr
ENABLE_RERANKER=true
ENABLE_QUERY_REWRITE=false
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
QUERY_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
LOG_JSON=true
