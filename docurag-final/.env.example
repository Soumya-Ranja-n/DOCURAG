APP_NAME=DocuRAG
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
DATA_DIR=/app/data
RAW_DATA_DIR=/app/data/raw
IMAGE_DATA_DIR=/app/data/images
INDEX_DATA_DIR=/app/data/index
DATABASE_URL=sqlite:////app/data/index/docurag.db
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TEXT_COLLECTION=docurag_text
QDRANT_IMAGE_COLLECTION=docurag_images
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_CACHE_DIR=/models
DEVICE=cpu
OCR_ENGINE=paddleocr
ENABLE_RERANKER=true
ENABLE_QUERY_REWRITE=false
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
QUERY_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
LOG_JSON=true
